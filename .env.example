# Firebase Configuration for Multi-Device Cloud Sync & Authentication
# 1. Create a free project at https://console.firebase.google.com/
# 2. Add a Web App in Firebase Project Settings
# 3. Enable Email/Password authentication in Firebase Authentication > Sign-in method
# 4. Copy the values below and rename this file to `.env.local`

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
